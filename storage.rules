rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userDoc() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.active == true; }
    function manager() { return activeUser() && userDoc().data.role in ['owner', 'admin']; }

    match /products/{userId}/{fileName} {
      allow read: if activeUser();
      allow create, update: if manager()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if manager();
    }
    match /store/{fileName} {
      allow read: if activeUser();
      allow write: if manager()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
